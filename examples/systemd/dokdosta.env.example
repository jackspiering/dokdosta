# /etc/whalenurse/whalenurse.env: mode 0640, owner root:whalenurse. systemd reads KEY=value lines (no export, no shell quoting).
# The full list with defaults: docs/configuration.md.

# Start in dry-run: decisions are logged (journalctl -u whalenurse) and notified, nothing is changed.
WHALENURSE_DRY_RUN=true

# Notifications: Shoutrrr URLs separated by spaces. Secrets.
#WHALENURSE_NOTIFY_URLS=ntfy://ntfy.example.com/replace-with-a-private-topic
#WHALENURSE_HEARTBEAT_URL=https://hc-ping.com/your-uuid

# The dashboard and the read-only API. Loopback needs no token; anything else does.
#WHALENURSE_HTTP_ADDR=127.0.0.1:8484
#WHALENURSE_HTTP_TOKEN=replace-with-openssl-rand-hex-24
