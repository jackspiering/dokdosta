# The release image, built by GoReleaser (dockers_v2, .goreleaser.yaml). GoReleaser compiles the binaries and puts them in the
# build context as <os>/<arch>/dokdosta, so this file only copies. The development and CI image is ./Dockerfile, which
# compiles from source; both must bundle the same compose release (scripts/ci/check-dockerfiles.sh compares them).
#
# The first stage downloads the bundled compose plugin and runs on the BUILD platform, so a multi-arch build needs no
# emulation (QEMU): the final stage has no RUN.
FROM --platform=$BUILDPLATFORM golang:1.27.3@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e AS fetch
ARG COMPOSE_VERSION=5.6.0
ARG COMPOSE_SHA256_AMD64=40343e21ca777173e69cff5dbafeb37c6f81f3b0d57d9e597f036e95eb63e76a
ARG COMPOSE_SHA256_ARM64=733ec76717ceb59052a9609b9dadfb523b2df8eab57a54212872d10a58078ea2
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) asset=x86_64; sum="$COMPOSE_SHA256_AMD64" ;; \
      arm64) asset=aarch64; sum="$COMPOSE_SHA256_ARM64" ;; \
      *) echo "no bundled compose for '$TARGETARCH'" >&2; exit 1 ;; \
    esac && \
    mkdir -p /out && \
    curl -fsSL -o /out/docker-compose "https://github.com/docker/compose/releases/download/v${COMPOSE_VERSION}/docker-compose-linux-${asset}" && \
    echo "${sum}  /out/docker-compose" | sha256sum -c - && \
    chmod 0755 /out/docker-compose
# The state store lives in /data; a fresh named volume copies the ownership of the image's directory.
RUN mkdir -p /out/data

FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
ARG TARGETPLATFORM
COPY --chmod=0755 $TARGETPLATFORM/dokdosta /dokdosta
COPY --from=fetch --chmod=0755 /out/docker-compose /usr/libexec/dokdosta/docker-compose
COPY --from=fetch --chown=65532:65532 /out/data /data
VOLUME ["/data"]
USER 65532:65532
# distroless/static has no shell, so the healthcheck calls the binary. The image runs as uid 65532, which cannot read the
# Docker socket: give it the socket's group at run time with group_add (docs/deployment.md).
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 CMD ["/dokdosta", "healthcheck"]
ENTRYPOINT ["/dokdosta"]
CMD ["run"]
